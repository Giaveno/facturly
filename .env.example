# === facturas-arca environment (placeholders only — no real secrets) ===
# Copy to .env.local and fill in real values. Never commit .env* files.

# PostgreSQL (Neon) connection string
DATABASE_URL=""

# NextAuth v5 secret (single accountant login)
AUTH_SECRET=""

# AES-256-GCM key for encrypting the ARCA X.509 certificate/key at rest.
# 32-byte key, hex or base64 encoded. Generate with: openssl rand -hex 32
AES_KEY=""

# Master switch for ARCA emission. "false" blocks new emissions while CAEs
# already issued remain valid.
EMISSIONS_ENABLED="false"

# NOTE: Clave Fiscal is NEVER requested or stored. The X.509 certificate and
# private key are provided out-of-band (filesystem/paths), not via env vars.
