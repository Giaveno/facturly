# === facturas-arca environment (placeholders only — no real secrets) ===
# Copy to .env.local and fill in real values. Never commit .env* files.

# PostgreSQL (Neon) connection string
DATABASE_URL=""

# NextAuth v5 secret (single accountant login)
AUTH_SECRET=""

# AES-256-GCM key for encrypting the ARCA X.509 certificate/key at rest.
# 32-byte key, hex or base64 encoded. Generate with: openssl rand -hex 32
AES_KEY=""

# Master switch for ARCA emission. "false" blocks new emissions while CAEs
# already issued remain valid.
EMISSIONS_ENABLED="false"

# === ARCA / WSAA / WSFEv1 (production vs homologación test environment) ===
ARCA_ENV="homologacion"
# REQUIRED to run against production (a typo would emit a REAL fiscal document).
# Set to "yes" only when you mean it. Default is homologación.
ARCA_CONFIRM_PRODUCTION=""

# The accountant's X.509 certificate. The cert PEM is PUBLIC and may be inline
# or a file path.
ARCA_CERT_PEM=""
# ARCA_CERT_FILE=""

# The private key is a FILE PATH ONLY — never inline via env vars (env vars leak
# via process listings, child processes, crash dumps, and CI logs). The key is
# encrypted at rest in the `credentials` table (AES_KEY) and decrypted JIT.
ARCA_KEY_FILE=""

# The delegated CLIENT CUIT whose wsfe delegation the homologación gate checks.
ARCA_CLIENT_CUIT=""
ARCA_PTO_VTA="1"
ARCA_CBTE_TIPO="6"

# NOTE: Clave Fiscal is NEVER requested or stored. The X.509 certificate and
# private key are provided out-of-band (filesystem paths / secret manager),
# NOT via env vars.
