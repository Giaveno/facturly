        "comprobantes_pto_vta_check": {
          "name": "comprobantes_pto_vta_check",
          "value": "\"comprobantes\".\"pto_vta\" BETWEEN 1 AND 99999"
        },
        "comprobantes_cbte_nro_check": {
          "name": "comprobantes_cbte_nro_check",
          "value": "\"comprobantes\".\"cbte_nro\" IS NULL OR \"comprobantes\".\"cbte_nro\" BETWEEN 1 AND 99999999"
        },
        "comprobantes_concepto_check": {
          "name": "comprobantes_concepto_check",
          "value": "\"comprobantes\".\"concepto\" IN (1, 2, 3)"
        },
        "comprobantes_aprobado_requirements_check": {
          "name": "comprobantes_aprobado_requirements_check",
          "value": "\"comprobantes\".\"estado\" <> 'aprobado' OR (\"comprobantes\".\"cae\" IS NOT NULL AND \"comprobantes\".\"cae_vto\" IS NOT NULL AND \"comprobantes\".\"cbte_nro\" IS NOT NULL)"
        },
        "comprobantes_pendiente_requirements_check": {
          "name": "comprobantes_pendiente_requirements_check",
          "value": "\"comprobantes\".\"estado\" <> 'pendiente' OR \"comprobantes\".\"cbte_nro\" IS NOT NULL"
        },
        "comprobantes_incierto_require_number_check": {
          "name": "comprobantes_incierto_require_number_check",
          "value": "\"comprobantes\".\"estado\" <> 'incierto' OR \"comprobantes\".\"cbte_nro\" IS NOT NULL"
        },
        "comprobantes_importes_non_negative_check": {
          "name": "comprobantes_importes_non_negative_check",
          "value": "\"comprobantes\".\"importe_neto_centavos\" >= 0 AND \"comprobantes\".\"importe_iva_centavos\" >= 0 AND \"comprobantes\".\"importe_exento_centavos\" >= 0 AND \"comprobantes\".\"importe_tributos_centavos\" >= 0 AND \"comprobantes\".\"importe_total_centavos\" >= 0"
        },
        "comprobantes_importes_total_check": {
          "name": "comprobantes_importes_total_check",
          "value": "\"comprobantes\".\"importe_total_centavos\" = \"comprobantes\".\"importe_neto_centavos\" + \"comprobantes\".\"importe_iva_centavos\" + \"comprobantes\".\"importe_exento_centavos\" + \"comprobantes\".\"importe_tributos_centavos\""
        }
      },
